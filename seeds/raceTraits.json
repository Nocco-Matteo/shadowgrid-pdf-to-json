    {
      "id": "race_lizardfolk_natural_armor",
      "raceName": "Lizardfolk (DMG)",
      "featureName": "Natural Armor",
      "grantedAtLevel": 1,
      "sources": [
        "dungeon_masters_guide"
      ],
      "effects": [
        {
          "kind": "ac_bonus",
          "amount": 3,
          "condition": "unarmored"
        }
      ],
      "notes": "The DMG printing, named as the compendium spells it so it does not collide with Volo's Lizardfolk, which grants 13 + DEX instead. This one states only '+3 bonus to Armor Class' and no armour condition; curated as unarmored because natural armour never stacks with worn armour in 5e."
    },
    {
      "id": "race_lizardfolk_volo_natural_armor",
      "raceName": "Lizardfolk",
      "featureName": "Natural Armor",
      "grantedAtLevel": 1,
      "sources": [
        "volos_guide_to_monsters"
      ],
      "effects": [
        {
          "kind": "ac_formula",
          "base": 13,
          "abilities": [
            "dex"
          ],
          "condition": "unarmored"
        }
      ],
      "notes": "Volo's printing: 'your AC is 13 + your Dexterity modifier'. The DMG's Lizardfolk instead gives a flat +3, which is why race matching prefers an exact name over a prefix."
    },
